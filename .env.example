# Bu dosyayı kopyala, adını .env yap ve kendi değerlerini yaz.
# .env dosyası .gitignore'da; GitHub'a gitmez.

# Claude API anahtarı. Sadece entegrasyon bilgisayarında (Ferhat) doldurulur.
ANTHROPIC_API_KEY=

# Hangi beyin? kurallar (varsayılan), claude (gerçek Claude, anahtar gerekir)
# veya sahte (anahtarsız deneme). Claude sorun yaşarsa kendisi kural beynine döner.
BEYIN=kurallar

# Robot bağlantısı: simülatör için "sim", Wokwi için "rfc2217://localhost:4000",
# gerçek robot için COM3 veya /dev/ttyUSB0 gibi port adı.
ROBOT_PORT=sim
